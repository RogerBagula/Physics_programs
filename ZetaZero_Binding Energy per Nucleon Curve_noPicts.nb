   RowBox[{
    RowBox[{
    "and", " ", "the", " ", "maximum", " ", "fmax\:200b", " ", "maps", " ", 
     "to", " ", "the", " ", "maximum", " ", "binding", " ", "energy", " ", 
     "near", " ", "Fe"}], "-", 
    RowBox[{"56", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[TildeTilde]", 
        RowBox[{"8.8", " ", "MeV"}]}], ")"}], "."}]}]}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.997975433974698*^9, 3.997975436476398*^9}},
 CellLabel->
  "In[156]:=",ExpressionUUID->"76e6db6e-50bc-4012-ab82-0f08f42c7a16"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
   "Since", " ", "nuclear", " ", "binding", " ", "energy", " ", "hovers", " ",
     "around", " ", "8.0", " ", "MeV"}], ",", 
   RowBox[{
   "scaling", " ", "of", " ", "the", " ", "function", " ", "by", " ", "a", 
    " ", "factor", " ", "of", " ", "roughly", " ", "8", " ", "places", " ", 
    "its", " ", "baseline", " ", "directly", " ", "on", " ", "top", " ", "of",
     " ", "the", " ", "binding", " ", "energy", " ", 
    RowBox[{"plateau", "."}]}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.997975518759344*^9, 3.997975536995388*^9}},
 CellLabel->
  "In[157]:=",ExpressionUUID->"da6c1cfb-2ffd-4ac0-9201-bb05106d756e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Define", " ", "the", " ", "Binding", " ", "Energy", " ", 
    "Curve", " ", 
    RowBox[{"B", "[", "A", "]"}], " ", "using", " ", "SEMF"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"aV", "=", "15.8"}], ";", 
    RowBox[{"aS", "=", "18.3"}], ";", 
    RowBox[{"aC", "=", "0.714"}], ";", 
    RowBox[{"aA", "=", "23.2"}], ";", 
    RowBox[{"aP", "=", "12.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"zOptimal", "[", "A_", "]"}], ":=", 
     RowBox[{"A", "/", 
      RowBox[{"(", 
       RowBox[{"2", "+", 
        RowBox[{"0.015", "*", 
         RowBox[{"A", "^", 
          RowBox[{"(", 
           RowBox[{"2", "/", "3"}], ")"}]}]}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"delta", "[", 
      RowBox[{"A_", ",", "Z_"}], "]"}], ":=", 
     RowBox[{"Switch", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{"Z", ",", "2"}], "]"}], ",", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"A", "-", "Z"}], ",", "2"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"aP", "/", 
        RowBox[{"A", "^", 
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{
        RowBox[{"-", "aP"}], "/", 
        RowBox[{"A", "^", 
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}]}]}], ",", "_", ",", "0"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"bindingEnergy", "[", "A_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Z", "=", 
         RowBox[{"Round", "[", 
          RowBox[{"zOptimal", "[", "A", "]"}], "]"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"aV", "*", "A"}], "-", 
        RowBox[{"aS", "*", 
         RowBox[{"A", "^", 
          RowBox[{"(", 
           RowBox[{"2", "/", "3"}], ")"}]}]}], "-", 
        RowBox[{"aC", "*", 
         RowBox[{
          RowBox[{"Z", "^", "2"}], "/", 
          RowBox[{"A", "^", 
           RowBox[{"(", 
            RowBox[{"1", "/", "3"}], ")"}]}]}]}], "-", 
        RowBox[{"aA", "*", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"A", "-", 
             RowBox[{"2", "*", "Z"}]}], ")"}], "^", "2"}], "/", "A"}]}], "+", 
        
        RowBox[{"delta", "[", 
         RowBox[{"A", ",", "Z"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"B", "[", "A_", "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"A", "==", "1"}], ",", "0", ",", 
       RowBox[{
        RowBox[{"bindingEnergy", "[", "A", "]"}], "/", "A"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"2.", " ", "Generate", " ", "your", " ", "Zeta"}], "-", 
     RowBox[{"Prime", " ", "function", " ", "sequence"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Nterms", "=", "100"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fVal", "[", "i_Integer", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], "/", "10"}], "*", 
      RowBox[{
       RowBox[{"Im", "[", 
        RowBox[{"N", "@", 
         RowBox[{"ZetaZero", "[", "i", "]"}]}], "]"}], "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Prime", "[", "i", "]"}], "]"}]}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zetaData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"fVal", "[", "i", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "Nterms"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Define", " ", "mapping", " ", "parameters"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Amin", "=", "1"}], ";", 
    RowBox[{"Amax", "=", "250"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "raw", " ", "f", 
     RowBox[{"(", "i", ")"}], " ", "min", " ", "and", " ", "max", " ", 
     "values"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fVals", "=", 
     RowBox[{"zetaData", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fMin", "=", 
     RowBox[{"Min", "[", "fVals", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fMax", "=", 
     RowBox[{"Max", "[", "fVals", "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Target", " ", "BE", " ", "min", " ", "and", " ", "max", " ", "values", 
     " ", "over", " ", "the", " ", "range"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beVals", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"B", "[", "A", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"A", ",", "Amin", ",", "Amax"}], "}"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"bMin", "=", 
     RowBox[{"Min", "[", "beVals", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bMax", "=", 
     RowBox[{"Max", "[", "beVals", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Linear", "/", "Conformal"}], " ", "Scaling", " ", "Functions"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mapDomain", "[", "i_", "]"}], ":=", 
     RowBox[{"Amin", "+", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"i", "-", "1"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"Nterms", "-", "1"}], ")"}]}], "*", 
       RowBox[{"(", 
        RowBox[{"Amax", "-", "Amin"}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"mapRange", "[", "y_", "]"}], ":=", 
     RowBox[{"bMin", "+", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"y", "-", "fMin"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"fMax", "-", "fMin"}], ")"}]}], "*", 
       RowBox[{"(", 
        RowBox[{"bMax", "-", "bMin"}], ")"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "4.", " ", "Transform", " ", "the", " ", "Zeta", " ", "points", " ", 
     "into", " ", "the", " ", "Binding", " ", "Energy", " ", "coordinate", 
     " ", "space"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"scaledZetaData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"mapDomain", "[", 
          RowBox[{"pt", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
         RowBox[{"mapRange", "[", 
          RowBox[{"pt", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"pt", ",", "zetaData"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"5.", " ", "Plot", " ", "the", " ", "Overlay"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"B", "[", "A", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"A", ",", "Amin", ",", "Amax"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Blue"}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "Amax"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "5"}], ",", "10"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Mass Number A (Mapped from Index i)\>\"", ",", 
        "\"\<Binding Energy per Nucleon (MeV)\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", 
      "\"\<Conformally Scaled Zeta-Prime Sequence Overlaid on BE/A \
Curve\>\""}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}], ",", 
     RowBox[{"Epilog", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Red", ",", 
          RowBox[{"PointSize", "[", "0.012", "]"}], ",", 
          RowBox[{"Point", "[", "scaledZetaData", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Red", ",", "Thick", ",", "Dashed", ",", 
          RowBox[{"Line", "[", "scaledZetaData", "]"}]}], "}"}]}], "}"}]}], 
     ",", 
     RowBox[{"ImageSize", "->", "Full"}]}], "]"}]}]}]], "Input",
