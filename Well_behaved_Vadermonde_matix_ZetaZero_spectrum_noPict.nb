Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Parameters"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nZeros", "=", "16"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"2.", " ", "Prime"}], "-", 
    RowBox[{"Normalized", " ", "Nodes"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gammas", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Im", "[", 
      RowBox[{"ZetaZero", "[", "i", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "nZeros"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"primes", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Prime", "[", "i", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "nZeros"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nodes", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Log", "[", 
      RowBox[{"1", "+", 
       RowBox[{
        RowBox[{"gammas", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"10", "*", 
          RowBox[{"primes", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "nZeros"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9979824627134247`*^9, 3.997982494202263*^9}, 
   3.9979826452180243`*^9},
