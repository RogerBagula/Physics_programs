  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Parameters"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nZeros", "=", "14"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "2.", " ", "Atomic", " ", "nuclear", " ", "weight", " ", "normalized", "  ", 
    RowBox[{"Nodes", ":", 
     RowBox[{
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"Im", "[", 
          RowBox[{"ZetaZero", "[", "8", "]"}], "]"}], "^", "2"}], "]"}], "~", 
       "neutron"}], " ", "weight"}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gammas", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"Im", "[", 
         RowBox[{"ZetaZero", "[", "i", "]"}], "]"}], "^", "2"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "nZeros"}], "}"}]}], "]"}]}], ";"}], "\n", 
  
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"primes", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Prime", "[", "i", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "nZeros"}], "}"}]}], "]"}]}], ";"}], 
   "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nodes", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Log", "[", 
      RowBox[{"1", "+", 
       RowBox[{
        RowBox[{"gammas", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "/", 
        RowBox[{"gammas", "[", 
         RowBox[{"[", "8", "]"}], "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "nZeros"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
