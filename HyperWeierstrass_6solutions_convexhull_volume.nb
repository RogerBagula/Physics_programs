Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"CompanionMatrix", "[", 
      RowBox[{"p_", ",", " ", "x_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"cl", "=", 
          RowBox[{"CoefficientList", "[", 
           RowBox[{"p", ",", " ", "x"}], "]"}]}], ",", " ", "deg", ",", " ", 
         "m"}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{"cl", "=", 
         RowBox[{"Drop", "[", 
          RowBox[{
           RowBox[{"cl", "/", 
            RowBox[{"Last", "[", "cl", "]"}]}], ",", " ", 
           RowBox[{"-", "1"}]}], "]"}]}], ";", " ", 
        RowBox[{"deg", "=", 
         RowBox[{"Length", "[", "cl", "]"}]}], ";", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"deg", "==", "1"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"-", "cl"}], "}"}], ",", " ", 
          RowBox[{
           RowBox[{"m", "=", 
            RowBox[{"RotateLeft", "[", 
             RowBox[{"IdentityMatrix", "[", "deg", "]"}], "]"}]}], ";", " ", 
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", " ", 
              RowBox[{"-", "1"}], "]"}], "]"}], "=", 
            RowBox[{"-", "cl"}]}], ";", " ", 
           RowBox[{"Transpose", "[", "m", "]"}]}]}], "]"}]}]}], "]"}]}], 
    ";"}], " "}],
  FontFamily->"Lucida Grande",
  FontSize->13]], "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"bf7138e5-4912-4bc3-9caf-b25050d39bd5"],

