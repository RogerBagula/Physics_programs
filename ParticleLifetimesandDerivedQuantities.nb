Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Example", " ", "usage", " ", "functions"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "Lookup", " ", "lifetime", " ", "by", " ", "particle", " ", "name"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getLifetimeByName", "[", "name_String", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "entry", "}"}], ",", 
       RowBox[{
        RowBox[{"entry", "=", 
         RowBox[{"SelectFirst", "[", 
          RowBox[{"particleTableComputed", ",", 
           RowBox[{
            RowBox[{"#Particle", "==", "name"}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MissingQ", "[", "entry", "]"}], ",", "$Failed", ",", 
          RowBox[{"entry", "[", "\"\<Lifetime\>\"", "]"}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Compute", " ", "derived", " ", "quantities", " ", "for", " ", "an", " ", 
     "arbitrary", " ", "lifetime"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"computeFromTau", "[", 
      RowBox[{"tau_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rx", ",", "mx", ",", "t0", ",", "gamma"}], "}"}], ",", 
       RowBox[{
        RowBox[{"rx", "=", 
         RowBox[{"rxFromTau", "[", "tau", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"mx", "=", 
         RowBox[{"mxFromRx", "[", "rx", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"t0", "=", 
         RowBox[{"t0OfX", "[", "rx", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"gamma", "=", 
         RowBox[{"GammaFromTau", "[", "tau", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<tau\>\"", "->", "tau"}], ",", 
          RowBox[{"\"\<rx_cm\>\"", "->", "rx"}], ",", 
          RowBox[{"\"\<mx_g\>\"", "->", "mx"}], ",", 
          RowBox[{"\"\<t0_check_s\>\"", "->", "t0"}], ",", 
          RowBox[{"\"\<Gamma_erg\>\"", "->", "gamma"}]}], "|>"}]}]}], "]"}]}],
     ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", "Examples", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"getLifetimeByName", "[", "\"\<Higgs\>\"", "]"}], "\n", 
   RowBox[{"computeFromTau", "[", 
    RowBox[{"1.56", "*", 
     RowBox[{"10", "^", 
      RowBox[{"-", "22"}]}]}], "]"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.992341945842144*^9, 3.992341945844002*^9}},
 CellLabel->
  "In[169]:=",ExpressionUUID->"a1a5fccb-e152-4d1a-a67a-05d0cc275f1e"],

