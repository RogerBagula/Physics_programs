Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Sanity", " ", "checks", " ", "and", " ", "notes"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"1", ")"}], " ", "Check", " ", "that", " ", 
    RowBox[{"t0OfX", "[", 
     RowBox[{"rxFromTau", "[", "tau", "]"}], "]"}], " ", "returns", " ", 
    "tau", " ", 
    RowBox[{"(", 
     RowBox[{"within", " ", "numeric", " ", "precision"}], ")"}], " ", "for", 
    " ", "a", " ", "sample", " ", "particle"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"sample", "=", 
     RowBox[{"particleTableComputed", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"Position", "[", 
         RowBox[{
          RowBox[{"particleTableComputed", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "\"\<Particle\>\""}], "]"}], "]"}], ",", 
          "\"\<Higgs\>\""}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tauSample", "=", 
     RowBox[{"sample", "[", "\"\<Lifetime\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rxSample", "=", 
     RowBox[{"sample", "[", "\"\<rx_cm\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t0Check", "=", 
     RowBox[{"t0OfX", "[", "rxSample", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<tau\>\"", "->", "tauSample"}], ",", 
     RowBox[{"\"\<t0Check\>\"", "->", "t0Check"}], ",", 
     RowBox[{"\"\<ratio\>\"", "->", 
      RowBox[{"t0Check", "/", "tauSample"}]}]}], "|>"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.992341958857193*^9, 3.992341958859236*^9}},
 CellLabel->
  "In[173]:=",ExpressionUUID->"6136f1c3-b90f-44d8-a9ed-279032c96492"],

